{
  "name": "crawlora/bing",
  "description": "Crawlora Bing API client with 5 endpoints for web, news, image, and video search plus query suggestions",
  "keywords": [
    "crawlora",
    "api-client",
    "web-scraping",
    "bing",
    "web",
    "news",
    "image",
    "video-search-query-suggestions"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Bing\\": "php/src/Crawlora/Bing/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Bing\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=bing-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-bing",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=bing-php-api-docs"
  }
}
